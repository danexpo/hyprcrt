#!/bin/bash
# crt-build - build the hyprcrt Hyprland plugin for the Hyprland that is installed, and wire it up.
#
#   crt-build [--no-load] [--no-autostart] [--build] [--source <dir>]
#
# A Hyprland plugin only loads into the exact Hyprland commit it was compiled against, so this script
# 1. reads the commit the installed headers describe (/usr/include/hyprland/src/version.h),
# 2. refuses to build if that differs from the running compositor (a pending restart after an update),
# 3. installs a prebuilt hyprcrt-<hash>.so from the project's releases when one exists (crt-fetch),
#    otherwise builds plugin/ with make (--build skips the download and always compiles),
#    and installs it as ~/.local/share/hyprcrt/hyprcrt-<hash>.so,
# 4. installs lua/loader.lua and, on Omarchy, the toggle file that sources it on every start
#    (or prints the line to add to a Hyprland config without Omarchy), and
# 5. loads it into the running session unless --no-load (scripts should always pass --no-load).
# MIT (c) 2026 Dan Expo
set -euo pipefail

here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
root=${HYPRCRT_ROOT:-$(cd "$here/.." && pwd)}
data=${XDG_DATA_HOME:-$HOME/.local/share}/hyprcrt
toggles=${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/toggles/hypr
load=1
autostart=1
forcebuild=0
while [ $# -gt 0 ]; do
    case "$1" in
        --no-load) load=0 ;;
        --no-autostart) autostart=0 ;;
        --build) forcebuild=1 ;;
        --source) root=$2; shift ;;
        -h|--help) sed -n '2,12p' "$0"; exit 0 ;;
        *) echo "crt-build: unknown option $1" >&2; exit 1 ;;
    esac
    shift
done

die() { echo "crt-build: $*" >&2; exit 1; }

# An agent session (Claude Code sets CLAUDECODE) never writes the live install: the tests run this under
# env -i HOME=<sandbox>, which drops that variable; HYPRCRT_LIVE=1 is the user's own override.
if [ -n "${CLAUDECODE:-}" ] && [ -z "${HYPRCRT_LIVE:-}" ]; then
    die "refusing to write the live $data from an agent session: run it under env -i HOME=<sandbox> on the same command line (tests/run-install-test.sh does), or HYPRCRT_LIVE=1 when the user asked for the real install"
fi


hdr=$(grep -m1 'GIT_COMMIT_HASH' "$(pkg-config --variable=includedir hyprland 2>/dev/null || echo /usr/include)/hyprland/src/version.h" 2>/dev/null | cut -d'"' -f2 || true)
[ -n "$hdr" ] || hdr=$(grep -m1 'GIT_COMMIT_HASH' /usr/include/hyprland/src/version.h | cut -d'"' -f2)
[ -n "$hdr" ] || die "cannot read the commit hash from the Hyprland headers"

running=""
if command -v hyprctl >/dev/null && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    running=$(hyprctl version -j 2>/dev/null | sed -n 's/.*"commit": *"\([0-9a-f]*\)".*/\1/p' | head -n1 || true)
fi
if [ -n "$running" ] && [ "$running" != "$hdr" ]; then
    die "the installed headers are for Hyprland $hdr but the running compositor is $running. Restart Hyprland (log out and in) so both match, then run crt-build again."
fi

mkdir -p "$data"
got=0
if [ "$forcebuild" = 0 ] && [ "$(cat "$data/built-for" 2>/dev/null)" != "$hdr" ]; then
    # a prebuilt library for this exact Hyprland saves the toolchain and the minute of compiling
    if "$here/crt-fetch"; then
        got=1
    else
        rc=$?
        [ "$rc" = 3 ] || echo "crt-build: prebuilt download failed, building locally" >&2
    fi
elif [ "$forcebuild" = 0 ] && [ -e "$data/hyprcrt.so" ]; then
    echo "crt-build: $data/hyprcrt.so already matches Hyprland ${hdr:0:12} (use --build to recompile)"
    got=1
fi

if [ "$got" = 0 ]; then
    [ -d "$root/plugin/src" ] || die "plugin sources not found under $root (use --source <repo>)"
    for t in g++ make pkg-config; do command -v "$t" >/dev/null || die "$t is required (pacman -S base-devel)"; done
    pkg-config --exists hyprland || die "Hyprland headers not found (pkg-config hyprland). On Arch they ship with the hyprland package."
    echo "crt-build: building for Hyprland ${hdr:0:12}"
    make -C "$root/plugin" clean >/dev/null
    make -C "$root/plugin" all -j"$(nproc)" OPT="-O2"

    # Never write into an installed .so in place: the running compositor may have that very file mapped
    # (dlopen), and truncating/rewriting a mapped library corrupts its pages, so the next dlsym() during
    # `hyprctl plugin unload` segfaults the whole session. Write beside it and rename over it instead:
    # the old inode stays intact for whoever has it open, the new one becomes visible atomically.
    tmp=$(mktemp "$data/.hyprcrt-$hdr.so.XXXXXX")
    cp "$root/plugin/out/hyprcrt.so" "$tmp"
    chmod 755 "$tmp"
    mv -f "$tmp" "$data/hyprcrt-$hdr.so"
    ln -sfn "hyprcrt-$hdr.so" "$data/hyprcrt.so.new" && mv -Tf "$data/hyprcrt.so.new" "$data/hyprcrt.so"
    echo "$hdr" > "$data/built-for"
    # keep the two most recent builds only (unlinking a mapped file is safe; only overwriting it is not)
    ls -t "$data"/hyprcrt-*.so 2>/dev/null | tail -n +3 | xargs -r rm -f
fi

# shaders next to the binary, so the plugin finds them without configuration
mkdir -p "$data/shaders"
cp -r "$root/shaders/." "$data/shaders/"

# the loader picks full or lite mode at every start and carries the crash-loop guard
[ -f "$root/lua/loader.lua" ] && cp "$root/lua/loader.lua" "$data/loader.lua"
line="pcall(dofile, \"$data/loader.lua\")"
if [ "$autostart" = 0 ]; then
    echo "crt-build: not registering the plugin for autostart (--no-autostart); load it with: hyprctl plugin load $data/hyprcrt.so"
elif [ -d "$(dirname "$toggles")" ]; then
    mkdir -p "$toggles"
    printf -- '-- hyprcrt: full mode when the plugin is built, lite mode otherwise (generated, do not edit)\n%s\n' "$line" > "$toggles/hyprcrt.lua"
    rm -f "$toggles/hyprcrt-plugin.lua" # pre-0.2 layout
    echo "crt-build: Hyprland will load $data/hyprcrt.so at start (via $toggles/hyprcrt.lua)"
else
    echo "crt-build: add this line to your Hyprland Lua config to load the plugin at start:"
    echo "  $line"
fi

# Loading into the live compositor is the user's call: a plugin runs inside Hyprland, and a fault
# there takes the whole session down. Scripts and automation should pass --no-load.
if [ "$load" = 1 ] && [ -n "$running" ]; then
    if hyprctl plugin list 2>/dev/null | grep -q "Plugin hyprcrt "; then
        hyprctl plugin unload "$data/hyprcrt.so" >/dev/null 2>&1 || true
    fi
    out=$(hyprctl plugin load "$data/hyprcrt.so" 2>&1) || true
    case "$out" in
        ok*) echo "crt-build: plugin loaded into the running session" ;;
        *) echo "crt-build: could not load into the running session ($out); it will load on the next start" ;;
    esac
fi
echo "crt-build: done"
