#!/bin/bash
# crt-fetch - install a prebuilt hyprcrt plugin for the Hyprland that is installed, without compiling.
#
#   crt-fetch [--check] [--quiet] [--want <version>]
#
# The CI publishes hyprcrt-<hyprland commit>.so plus SHA256SUMS and VERSIONS files to a rolling "prebuilt"
# GitHub release (and to every tagged release). This script reads the commit the installed Hyprland headers
# describe, downloads the matching library and its checksum line, verifies the checksum, and installs
# it atomically as ~/.local/share/hyprcrt/hyprcrt-<hash>.so (never overwriting a file the running
# compositor may have mapped), recording the Hyprland commit in built-for and the hyprcrt version the
# library was built from (its VERSIONS line) in built-version. Exit 0 on success, 3 when no prebuilt
# exists for this Hyprland (build locally with crt-build), 1 on any other error. --check only reports
# whether one exists. --want <version> takes the prebuilt only when it is that hyprcrt version (the one
# the sources at hand carry): a library of another version, or one whose version the release does not
# state, is left alone (exit 3), so crt-build compiles the sources instead.
# MIT (c) 2026 Dan Expo
set -euo pipefail

# The GitHub repository the releases live in. Override with HYPRCRT_REPO=owner/name, or point
# HYPRCRT_RELEASE_URL at any directory that serves SHA256SUMS and hyprcrt-<hash>.so.
repo=${HYPRCRT_REPO:-danexpo/hyprcrt}
base=${HYPRCRT_RELEASE_URL:-https://github.com/$repo/releases/download/prebuilt}
data=${XDG_DATA_HOME:-$HOME/.local/share}/hyprcrt
check=0 quiet=0 want=""
while [ $# -gt 0 ]; do
    case "$1" in
        --check) check=1 ;;
        --quiet) quiet=1 ;;
        --want) want=$2; shift ;;
        -h|--help) sed -n '2,12p' "$0"; exit 0 ;;
        *) echo "crt-fetch: unknown option $1" >&2; exit 1 ;;
    esac
    shift
done

say() { [ "$quiet" = 1 ] || echo "crt-fetch: $*"; }
die() { echo "crt-fetch: $*" >&2; exit 1; }

hdr=$(grep -m1 'GIT_COMMIT_HASH' "$(pkg-config --variable=includedir hyprland 2>/dev/null || echo /usr/include)/hyprland/src/version.h" 2>/dev/null | cut -d'"' -f2 || true)
[ -n "$hdr" ] || hdr=$(grep -m1 'GIT_COMMIT_HASH' /usr/include/hyprland/src/version.h 2>/dev/null | cut -d'"' -f2 || true)
if [ -z "$hdr" ] && command -v hyprctl >/dev/null && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    hdr=$(hyprctl version -j 2>/dev/null | sed -n 's/.*"commit": *"\([0-9a-f]*\)".*/\1/p' | head -n1 || true)
fi
[ -n "$hdr" ] || die "cannot tell which Hyprland commit is installed (no headers, no running compositor)"

# Bounded, so a network that hangs (a captive portal, a firewall that drops packets) gives up about as soon as one that
# refuses and crt-build compiles instead: 5 s to connect, 20 s without a byte, no retry once 20 s are spent. A stall
# bound rather than a total one (--max-time), so a slow but live link still gets the 9 MB library.
fetch() { # url dest
    if command -v curl >/dev/null; then curl -fsSL --connect-timeout 5 --speed-time 20 --retry 2 --retry-max-time 20 -o "$2" "$1"
    elif command -v wget >/dev/null; then wget -q --timeout=20 --tries=1 -O "$2" "$1"
    else die "curl or wget is required"; fi
}

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
if ! fetch "$base/SHA256SUMS" "$tmp/SHA256SUMS" 2>/dev/null; then
    say "no prebuilt release reachable at $base"
    exit 3
fi
line=$(grep -E "  hyprcrt-$hdr\.so$" "$tmp/SHA256SUMS" || true)
if [ -z "$line" ]; then
    say "no prebuilt plugin for Hyprland ${hdr:0:12} (build one with crt-build)"
    exit 3
fi
# which hyprcrt the library was built from: the rolling release keeps one library per Hyprland commit, each from
# whatever hyprcrt was current when it was built, so the version is per line, not per release
ver=""
if fetch "$base/VERSIONS" "$tmp/VERSIONS" 2>/dev/null; then
    ver=$(sed -n "s/^\([^ ]*\)  hyprcrt-$hdr\.so\$/\1/p" "$tmp/VERSIONS" | head -n1)
fi
if [ -n "$want" ] && [ "$ver" != "$want" ]; then
    say "the prebuilt plugin for Hyprland ${hdr:0:12} is hyprcrt ${ver:-of an unstated version}, the sources are $want (build one with crt-build)"
    exit 3
fi
if [ "$check" = 1 ]; then
    say "a prebuilt plugin exists for Hyprland ${hdr:0:12}${ver:+ (hyprcrt $ver)}"
    exit 0
fi

say "downloading hyprcrt-${hdr:0:12}.so"
fetch "$base/hyprcrt-$hdr.so" "$tmp/hyprcrt-$hdr.so" || die "download failed"
(cd "$tmp" && printf '%s\n' "$line" | sha256sum -c --quiet -) || die "checksum mismatch, not installing"

mkdir -p "$data"
out=$(mktemp "$data/.hyprcrt-$hdr.so.XXXXXX")
cp "$tmp/hyprcrt-$hdr.so" "$out"
chmod 755 "$out"
mv -f "$out" "$data/hyprcrt-$hdr.so"          # rename: a mapped older inode stays valid
ln -sfn "hyprcrt-$hdr.so" "$data/hyprcrt.so.new" && mv -Tf "$data/hyprcrt.so.new" "$data/hyprcrt.so"
echo "$hdr" > "$data/built-for"
echo "${ver:-unknown}" > "$data/built-version"
ls -t "$data"/hyprcrt-*.so 2>/dev/null | tail -n +3 | xargs -r rm -f
say "installed $data/hyprcrt.so (hyprcrt ${ver:-of an unstated version}) for Hyprland ${hdr:0:12}"
