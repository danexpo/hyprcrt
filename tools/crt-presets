#!/bin/sh
# crt-presets - write the preset tables in bin/hyprcrt (lite_preset_knobs) and plugin/src/Look.hpp (applyPreset)
# from presets/*.conf, the one place the preset numbers are kept. Edit a preset file, run this, commit all three.
# Only the lines between the ">>> generated" and "<<< generated" markers are rewritten.
#
# usage: crt-presets [--check]     --check: change nothing, exit 1 if either table is not what would be written
# POSIX sh + awk only. MIT (c) 2026 Dan Expo.
set -eu
export LC_ALL=C # the glob's order is the tables' order, the same on every machine
here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "${HYPRCRT_ROOT:-$here/..}" && pwd)
check=0
case "${1:-}" in --check) check=1 ;; '') ;; *) echo "usage: crt-presets [--check]" >&2; exit 2 ;; esac
die() { echo "crt-presets: $*" >&2; exit 1; }

# each preset as "name curve lines mask glow gamma sharp", checked against the knobs' ranges
rows=""
for f in "$root"/presets/*.conf; do
    [ -f "$f" ] || die "no presets in $root/presets"
    name=$(basename "$f" .conf)
    case "$name" in custom|*[!a-z]*) die "${f#"$root"/}: a preset name is lower-case letters and not \"custom\"" ;; esac
    row=$(awk -F= -v name="$name" -v file="${f#"$root"/}" '
        BEGIN { split("curve lines mask glow gamma sharp", k, " "); split("1 4 3 4 4 4", max, " ") }
        /^[[:space:]]*(#|$)/ { next }
        { v[$1] = $2 }
        END {
            line = name
            for (i = 1; i <= 6; i++) {
                x = v[k[i]]
                if (x !~ /^[0-9]+$/ || x + 0 > max[i] + 0) {
                    printf "crt-presets: %s: %s must be an integer 0-%s (found \"%s\")\n", file, k[i], max[i], x > "/dev/stderr"; exit 1
                }
                line = line " " (x + 0)
            }
            print line
        }' "$f") || exit 1
    rows="$rows$row
"
done

shell_table=$(printf '%s' "$rows" | awk '{ printf "        %-12scurve=%s lines=%s mask=%s glow=%s gamma=%s sharp=%s ;;\n", $1 ")", $2, $3, $4, $5, $6, $7 }')
cpp_table=$(printf '%s' "$rows" | awk '{
    printf "    %sif (name == \"%s\") {\n", (NR > 1 ? "} else " : ""), $1
    printf "        k.curve = %s; k.lines = %s; k.mask = %s; k.glow = %s; k.gamma = %s; k.sharp = %s;\n", $2, $3, $4, $5, $6, $7 }
    END { print "    } else\n        return false;" }')

# splice <file> <table>: the file with the lines between the markers replaced by the table, into <file>.tmp
changed=0
splice() {
    f=$1 table=$2
    [ -f "$f" ] || die "$f not found"
    cp -p "$f" "$f.tmp"
    awk -v table="$table" '
        /(#|\/\/) >>> generated by tools\/crt-presets/ { print; print table; skip = 1; seen++; next }
        /(#|\/\/) <<< generated/                       { skip = 0; ended++ }
        !skip { print }
        END { if (seen != 1 || ended != 1 || skip) exit 3 }' "$f" > "$f.tmp" ||
        { rm -f "$f.tmp"; die "${f#"$root"/}: expected one \">>> generated by tools/crt-presets\" marker and one \"<<< generated\""; }
    if cmp -s "$f" "$f.tmp"; then
        rm -f "$f.tmp"
    elif [ "$check" = 1 ]; then
        echo "crt-presets: ${f#"$root"/} is out of step with presets/*.conf:" >&2
        diff "$f" "$f.tmp" >&2 || true
        rm -f "$f.tmp"; changed=1
    else
        mv -f "$f.tmp" "$f"; echo "crt-presets: wrote ${f#"$root"/}"; changed=1
    fi
}
splice "$root/bin/hyprcrt" "$shell_table"
splice "$root/plugin/src/Look.hpp" "$cpp_table"

if [ "$check" = 1 ]; then
    [ "$changed" = 0 ] || { echo "crt-presets: run tools/crt-presets to regenerate them" >&2; exit 1; }
    echo "crt-presets: both tables are what presets/*.conf generates"
elif [ "$changed" = 0 ]; then
    echo "crt-presets: both tables already match presets/*.conf"
fi
