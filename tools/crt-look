#!/bin/sh
# crt-look - turn a preset (key=value file) plus overrides into the numbers the shaders need.
# The one place the knob -> look mapping lives outside the plugin (which mirrors it in plugin/src/Look.hpp).
# Prints KEY=VALUE lines. POSIX sh + awk only.
#
# usage: crt-look [preset.conf] [key=value ...]
# knobs: curve 0/1  lines 0-4  mask 0-3  glow 0-4  gamma 0-4  sharp 0-4
#        pitch 1-8 (physical px per virtual source px)  mask_pitch 1-3  gain 0.25-4  textsafe 0/1
set -eu

curve=0 lines=3 mask=1 glow=2 gamma=1 sharp=3 pitch=2 mask_pitch=1 gain=1.0 textsafe=1

if [ $# -gt 0 ] && [ -f "$1" ]; then
    # shellcheck disable=SC1090
    while IFS='=' read -r k val; do
        case "$k" in ''|\#*) continue ;; esac
        eval "$k=\"\$val\""
    done < "$1"
    shift
fi
for kv in "$@"; do
    case "$kv" in *=*) ;; *) continue ;; esac
    k=${kv%%=*}; val=${kv#*=}
    case "$k" in curve|lines|mask|glow|gamma|sharp|pitch|mask_pitch|gain|textsafe) eval "$k=\"\$val\"" ;; esac
done

awk -v curve="$curve" -v lines="$lines" -v mask="$mask" -v glow="$glow" -v gamma="$gamma" -v sharp="$sharp" \
    -v pitch="$pitch" -v mask_pitch="$mask_pitch" -v gain="$gain" -v textsafe="$textsafe" 'BEGIN {
    split("-1.6 -2.6 -4.0 -6.0 -8.0", hard, " ");
    split("2.0 0.44 0.38 0.32 0.28", sigd, " ");
    split("1.0 1.15 1.22 1.28 1.34", cap, " ");
    split("0.0 0.05 0.09 0.14 0.20", halo, " ");
    split("0.0 0.03 0.05 0.07 0.10", gin, " ");
    split("2.0 2.2 2.4 2.6 2.8", gam, " ");
    clamp(lines, 0, 4); lines = c; clamp(glow, 0, 4); glow = c; clamp(gamma, 0, 4); gamma = c; clamp(sharp, 0, 4); sharp = c;
    clamp(mask, 0, 3); mask = c; clamp(pitch, 1, 8); pitch = c; clamp(mask_pitch, 1, 3); mask_pitch = c;
    gain = gain + 0; if (gain < 0.25) gain = 0.25; if (gain > 4) gain = 4;   # as Look.hpp: never a black screen
    if (curve != 0) curve = 1;
    # text-safe: at pitch 1 there are no source rows to draw lines between, and a mask on 1px text smears it
    if (textsafe != 0 && pitch < 2) { lines = 0; mask = 0; }
    # two pixels cannot hold a triad (crt.c: if (f < 3) mask = 0) - at pitch 2 keep it only with mask_pitch 1
    hp = hard[sharp + 1]; hpr = hp * (sharp <= 1 ? 0.6 : 0.85);
    sd = sigd[lines + 1]; sb = (lines > 0) ? sd + 0.12 : 2.0; bc = cap[lines + 1];
    if (mask == 1) { ml = 1.30; md = 0.76 } else if (mask == 2 || mask == 3) { ml = 1.26; md = 0.80 } else { ml = 1.0; md = 1.0 }
    mean = (ml + 2.0 * md) / 3.0; mg = (mask != 0) ? 1.0 / mean : 1.0; slot = 0.55;
    if (mask == 2) mg /= (3.0 + slot) / 4.0;
    ha = halo[glow + 1]; gi = gin[glow + 1];
    if (curve) { wx = 0.031; wy = 0.041; vg = 0.22 } else { wx = 0; wy = 0; vg = 0 }
    go = gam[gamma + 1];
    printf "CURVE=%d\nLINES=%d\nMASK=%d\nGLOW=%d\nGAMMA_KNOB=%d\nSHARP=%d\n", curve, lines, mask, glow, gamma, sharp;
    printf "PITCH=%.1f\nMASK_PITCH=%.1f\nGAIN=%.4f\n", pitch, mask_pitch, gain;
    printf "HARD_PIX=%.4f\nHARD_PIX_R=%.4f\n", hp, hpr;
    printf "SIG_DARK=%.4f\nSIG_BRIGHT=%.4f\nBOOST_CAP=%.4f\nFLAT_LINES=%d\n", sd, sb, bc, (sd >= 1.0) ? 1 : 0;
    printf "MASK_LIGHT=%.5f\nMASK_DARK=%.5f\nSLOT_DIM=%.3f\n", ml * mg, md * mg, slot;
    printf "HALO_AMT=%.4f\nGLOW_IN=%.4f\nGLOW_R=0.55\nGLOW_G=0.50\nGLOW_B=0.33\n", ha, gi;
    printf "WARP_X=%.4f\nWARP_Y=%.4f\nVIGNETTE=%.4f\n", wx, wy, vg;
    printf "GAMMA_OUT=%.2f\nINV_GAMMA=%.6f\n", go, 1.0 / go;
}
function clamp(x, lo, hi) { x = x + 0; if (x < lo) x = lo; if (x > hi) x = hi; c = int(x); }'
