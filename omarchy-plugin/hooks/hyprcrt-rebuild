#!/bin/bash
# hyprcrt post-update hook for Omarchy (~/.config/omarchy/hooks/post-update.d/hyprcrt-rebuild).
# After `omarchy update` finishes, rebuild the CRT plugin when Hyprland changed underneath it.
# A plugin only loads into the exact Hyprland commit it was built for, so without this the full mode
# silently stops after the next Hyprland update and the filter falls back to lite mode.
#
# Installed by: omarchy hook install post-update <this file>   (hyprcrt install does it for you)
set -u
data=${XDG_DATA_HOME:-$HOME/.local/share}/hyprcrt
built=$(cat "$data/built-for" 2>/dev/null || true)
hdr=$(grep -m1 GIT_COMMIT_HASH /usr/include/hyprland/src/version.h 2>/dev/null | cut -d'"' -f2 || true)
[ -n "$hdr" ] || exit 0                 # no headers, nothing to do
[ -f "$data/hyprcrt.so" ] || exit 0     # full mode was never built: stay in lite mode
[ "$built" = "$hdr" ] && exit 0         # still matching

src=""
for c in "$HOME/.config/omarchy/plugins/danexpo.crt" "$HOME/.config/omarchy/plugins/hyprcrt" "$data/src"; do
    [ -d "$c/plugin/src" ] && src=$c && break
done
if [ -z "$src" ]; then
    echo "hyprcrt: Hyprland changed to ${hdr:0:8} but the plugin sources were not found; run: hyprcrt build --source <repo>" >&2
    exit 0
fi

# The running compositor is still the old one; build for the new headers without loading.
if "$src/tools/crt-build" --no-load --source "$src"; then
    command -v omarchy-notification-send >/dev/null && omarchy-notification-send -u low "CRT filter rebuilt for the new Hyprland; it loads after the next restart" || true
else
    command -v omarchy-notification-send >/dev/null && omarchy-notification-send -u critical "CRT filter: rebuild failed, running in lite mode (see hyprcrt build)" || true
    rm -f "$data/hyprcrt.so"   # do not let Hyprland try to load a stale .so at start
fi
exit 0
