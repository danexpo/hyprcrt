#!/bin/bash
# presetcheck - the preset numbers live as data in presets/*.conf and as two generated copies, the lite path's table
# in bin/hyprcrt (lite_preset_knobs) and the plugin's in plugin/src/Look.hpp (applyPreset), written by
# tools/crt-presets. Fails when a copy names a different set of presets or a different value for any of the six
# knobs (read here independently of the generator), or when a table is not byte for byte what the generator writes.
#   tests/presetcheck
# MIT (c) 2026 Dan Expo.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
knobs=(curve lines mask glow gamma sharp)
fails=0
bad() { echo "  FAIL $*"; fails=$((fails + 1)); }

# every table becomes lines of "<preset> curve=… lines=… mask=… glow=… gamma=… sharp=…", in knob order, sorted
from_data() {
    local f name k line
    for f in "$root"/presets/*.conf; do
        name=$(basename "$f" .conf) line=$name
        for k in "${knobs[@]}"; do
            line+=" $k=$(sed -n "s/^$k=\([^[:space:]]*\).*/\1/p" "$f" | tail -n1)"
        done
        echo "$line"
    done | sort
}
from_shell() { # the case arms of lite_preset_knobs: `  name)  curve=0 lines=0 … ;;`
    awk '/^lite_preset_knobs\(\)/ { on = 1; next } on && /^}/ { exit }
         on && match($0, /^[[:space:]]*[a-z]+\)[[:space:]]+curve=/) {
             name = $1; sub(/\).*/, "", name); body = $0; sub(/^[^)]*\)/, "", body); sub(/;;.*/, "", body)
             print name, body }' "$root/bin/hyprcrt" | knob_order
}
from_cpp() { # applyPreset: `if (name == "x") {` and on the next line `k.curve = 0; k.lines = 0; …`
    awk '/applyPreset\(/ { on = 1; next } on && /^}/ { exit }
         on && match($0, /name == "[a-z]+"/) { name = substr($0, RSTART + 9, RLENGTH - 10); next }
         on && name != "" && /k\.curve/ { body = $0; gsub(/k\./, "", body); gsub(/ = /, "=", body); gsub(/;/, "", body)
             print name, body; name = "" }' "$root/plugin/src/Look.hpp" | knob_order
}
knob_order() { # "<name> k=v k=v …" in any order -> the six knobs in order; a missing knob reads as empty
    local name rest k v line
    while read -r name rest; do
        line=$name
        for k in "${knobs[@]}"; do
            v=$(tr ' ' '\n' <<<"$rest" | sed -n "s/^$k=//p" | tail -n1)
            line+=" $k=$v"
        done
        echo "$line"
    done | sort
}

data=$(from_data)
[ -n "$data" ] || { echo "presets: no presets/*.conf"; exit 1; }
for copy in shell cpp; do
    case $copy in shell) where=bin/hyprcrt; table=$(from_shell) ;; cpp) where=plugin/src/Look.hpp; table=$(from_cpp) ;; esac
    [ -n "$table" ] || { bad "$where: no preset table found"; continue; }
    if [ "$data" = "$table" ]; then
        echo "  ok   $where agrees with presets/*.conf ($(wc -l <<<"$table") presets)"
    else
        bad "$where disagrees with presets/*.conf:"
        diff <(echo "$data") <(echo "$table") | sed -n 's/^</    presets\/*.conf:/p; s/^>/    '"${where//\//\\/}"':/p' || true
    fi
done
if out=$("$root/tools/crt-presets" --check 2>&1); then
    echo "  ok   both tables are what tools/crt-presets writes"
else
    bad "the tables are not what tools/crt-presets writes:"; sed 's/^/    /' <<<"$out"
fi

# ---- the default look ---------------------------------------------------------------------------------
# The six numbers of the default preset are also both modes' defaults, and used to be hand-copied into
# bin/hyprcrt's lite_read and plugin/src/main.cpp's plugin:crt:* registrations. tools/crt-presets names the
# default preset; this reads each mode's effective defaults back and checks they are that preset's numbers.
default=$(sed -n 's/^default_preset=\([a-z][a-z]*\).*/\1/p' "$root/tools/crt-presets" | tail -n1)
[ -n "$default" ] && [ -f "$root/presets/$default.conf" ] ||
    { echo "  FAIL tools/crt-presets: no default_preset= naming a presets/*.conf"; exit 1; }
want=$(from_data | grep "^$default ")

from_shell_defaults() { # lite mode with no state file: `hyprcrt status`, sandboxed away from the real profile
    local tmp status name line k
    tmp=$(mktemp -d)
    status=$(env -i PATH="$PATH" HOME="$tmp" XDG_CONFIG_HOME="$tmp/config" XDG_STATE_HOME="$tmp/state" \
                 XDG_DATA_HOME="$tmp/data" XDG_CACHE_HOME="$tmp/cache" "$root/bin/hyprcrt" status) || status=''
    rm -rf "$tmp"
    name=$(grep -o '"preset":"[a-z]*"' <<<"$status" | head -n1 | cut -d'"' -f4)
    line=$name
    for k in "${knobs[@]}"; do line+=" $k=$(grep -o "\"$k\":[0-9]*" <<<"$status" | head -n1 | cut -d: -f2)"; done
    echo "$line"
}
cpp_arg() { # the default-value argument of a plugin:crt:<key> registration, as written in main.cpp
    local line
    line=$(grep -F "\"plugin:crt:$1\"" "$root/plugin/src/main.cpp" | head -n1)
    line=${line#*makeShared<}                              # CIntValue>("plugin:crt:x", "help, with commas", 3, …
    line=$(sed 's/"[^"]*"//; s/"[^"]*"//' <<<"$line")      # CIntValue>(, , 3, …   (the key and the help text gone)
    sed 's/^[^(]*( *, *, *//; s/[,)].*$//; s/[[:space:]]*$//' <<<"$line"
}
from_cpp_defaults() { # the same registrations, with `d.curve`-style expressions resolved through applyPreset
    local name row line k v e
    e=$(cpp_arg preset)
    case $e in
        '"'*'"') name=$(sed 's/"//g' <<<"$e") ;;
        *) name=$(sed -n "s/.*$e *= *\"\([a-z]*\)\".*/\1/p" "$root/plugin/src/Look.hpp" | tail -n1) ;;
    esac
    row=$(from_cpp | grep "^${name:-nosuch} ") || row=''
    line=${name:-?}
    for k in "${knobs[@]}"; do
        e=$(cpp_arg "$k")
        case $e in
            [0-9]*) v=$e ;;                                               # a hand-written literal
            *.$k)   v=$(tr ' ' '\n' <<<"$row" | sed -n "s/^$k=//p") ;;    # taken from the generated table
            *)      v="?$e" ;;
        esac
        line+=" $k=$v"
    done
    echo "$line"
}

for copy in shell cpp; do
    case $copy in
        shell) where="bin/hyprcrt lite_read"  have=$(from_shell_defaults) ;;
        cpp)   where="main.cpp plugin:crt:*"  have=$(from_cpp_defaults) ;;
    esac
    if [ "$want" = "$have" ]; then
        echo "  ok   $where defaults are presets/$default.conf ($want)"
    else
        bad "$where defaults are not presets/$default.conf:"
        echo "    presets/$default.conf: $want"
        echo "    ${where}: $have"
    fi
done

[ "$fails" = 0 ] || { echo "presets: out of step with presets/*.conf; run tools/crt-presets and commit the three together"; exit 1; }
echo "presets: bin/hyprcrt and Look.hpp carry the numbers in presets/*.conf as tools/crt-presets writes them, and both modes default to presets/$default.conf"
